{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FitnessTracker",
  "version": "../package.json",
  "identifier": "com.mihaimicle.fitnesstracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:native",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FitnessTracker",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "HealthcareAndFitness",
    "shortDescription": "Nutrition, workouts and progress tracking",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
